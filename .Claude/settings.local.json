{
  "permissions": {
    "allow": [
      "Read(//mnt/**)",
      "Read(//h//**)",
      "Read(//h/the hyper vibe coding hub/**)",
      "Bash(node cli/validate.js templates/python-starter/)",
      "Bash(node cli/validate.js templates/node-starter/)",
      "Bash(node cli/index.js validate templates/node-starter/ --strict)",
      "Bash(node cli/index.js validate templates/python-starter/ --strict)",
      "Bash(node cli/index.js registry build templates/ --out registry.json)",
      "Bash(node -e \"const r=require\\('./registry.json'\\); console.log\\(JSON.stringify\\(r, null, 2\\)\\)\")",
      "Bash(node cli/index.js registry search --runtime node)",
      "Bash(node cli/index.js registry show my-node-agent)",
      "Bash(node cli/index.js --help)",
      "Bash(node -e \"require\\('./cli/studio'\\); console.log\\('studio.js loads OK'\\)\")",
      "Bash(node cli/index.js studio --no-open --port 4041)",
      "Bash(curl -s http://localhost:4041/api/registry)",
      "Bash(node -e \"const d=require\\('fs'\\).readFileSync\\('/dev/stdin','utf8'\\); const j=JSON.parse\\(d\\); console.log\\('agents:', j.agent_count, '| first:', j.agents[0].name\\)\")",
      "Bash(curl -s http://localhost:4041/api/memory)",
      "Bash(node -e \"const d=require\\('fs'\\).readFileSync\\('/dev/stdin','utf8'\\); const j=JSON.parse\\(d\\); console.log\\('memory results:', j.results.map\\(r=>r.name+':'+r.status\\).join\\(', '\\)\\)\" kill %1)",
      "Bash(node cli/index.js studio --no-open --port 4042)",
      "Bash(node -e ':*)",
      "Bash(kill %1)",
      "Bash(node cli/index.js studio --no-open --port 4043)",
      "Bash(node cli/index.js status)",
      "Bash(node cli/index.js logs --tail 10)",
      "Bash(node cli/index.js agents list)",
      "Bash(node cli/index.js tokens award 123456789012345678 100)",
      "Bash(node --test tests/)",
      "Bash(node --test tests/*.test.js)",
      "Bash(npm test *)",
      "Bash(npm pack *)",
      "Bash(node cli/index.js init --help)",
      "Bash(node cli/index.js)",
      "Bash(mkdir -p /tmp/bad-agent)",
      "Bash(node cli/index.js validate /tmp/bad-agent)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/HyperAgent-SDK/scripts/sdk_session_start.py\"; exit 0",
            "shell": "powershell",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/HyperAgent-SDK/scripts/sdk_broski_xp_reward.py\" --xp 10 --reason session_start; exit 0",
            "shell": "powershell",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/HyperAgent-SDK/scripts/sdk_env_guard.py\"; exit 0",
            "shell": "powershell",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/HyperAgent-SDK/scripts/sdk_session_end.py\"; exit 0",
            "shell": "powershell",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/HyperAgent-SDK/scripts/sdk_broski_xp_reward.py\" --xp 5 --reason session_end; exit 0",
            "shell": "powershell",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/HyperAgent-SDK/scripts/sdk_env_guard.py\"; exit 0",
            "if": "Bash(npm run*)",
            "shell": "powershell",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$j = $input | ConvertFrom-Json; $f = $j.tool_input.file_path; if ($f -match 'hyper-agent-spec\\.json|registry\\.json') { python3 \"H:/HYPERFOCUSZONE/HperCore/HyperAgent-SDK/scripts/sdk_config_validator.py\" $f }",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "hyper-sills",
    "github",
    "filesystem"
  ]
}
